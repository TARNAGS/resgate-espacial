{
  "players": {
    "$nick": {
      ".read": true,
      ".validate": "$nick.matches(/^[A-Z0-9_]{3,12}$/)",
      "levels": {
        "$level": {
          ".write": "newData.exists()",
          ".validate": "$level.matches(/^[a-z0-9-]{1,24}$/) && newData.hasChildren(['completed', 'rescues']) && (!data.child('best').exists() || newData.child('best').exists())",
          "completed": { ".validate": "newData.isBoolean() && (!data.exists() || data.val() === false || newData.val() === true)" },
          "rescues": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && (!data.exists() || newData.val() >= data.val())" },
          "best": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 3600 && (!data.exists() || newData.val() <= data.val())" },
          "$other": { ".validate": false }
        }
      },
      "seen": {
        "$screen": {
          ".write": "newData.exists()",
          ".validate": "$screen.matches(/^[A-Za-z0-9_-]{1,24}$/) && newData.val() === true"
        }
      },
      "praise": {
        "$kind": {
          ".write": "newData.exists()",
          ".validate": "$kind.matches(/^[A-Za-z]{1,24}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && (!data.exists() || newData.val() >= data.val())"
        }
      },
      "settings": {
        ".write": "newData.exists()",
        "sound": { ".validate": "newData.isBoolean()" },
        "control": { ".validate": "newData.isString() && newData.val().length <= 8" },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    }
  }
}
