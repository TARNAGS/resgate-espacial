{
  "rules": {
    ".read": false,
    ".write": false,
    "scores": {
      ".read": true,
      "$level": {
        "$nick": {
          ".write": "!data.exists() || (newData.exists() && newData.child('time').val() < data.child('time').val())",
          ".validate": "$level.matches(/^[a-z0-9-]+_[a-z0-9]+$/) && $nick.matches(/^[A-Z0-9_]{3,12}$/) && newData.hasChildren(['time', 'at'])",
          "time": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 3600"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "control": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "telemetry": {
      ".read": true,
      "$day": {
        "$id": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && $id.matches(/^[a-z0-9]{6,24}$/) && newData.hasChildren(['ev', 't', 'sid'])",
          "$field": {
            ".validate": "newData.isNumber() || newData.isBoolean() || (newData.isString() && newData.val().length <= 80)"
          }
        }
      }
    },
    "players": {
      "$nick": {
        ".read": true,
        ".validate": "$nick.matches(/^[A-Z0-9_]{3,12}$/)",
        "levels": {
          "$level": {
            ".write": "newData.exists()",
            ".validate": "$level.matches(/^[a-z0-9-]{1,24}$/) && newData.hasChildren(['completed', 'rescues']) && (!data.child('best').exists() || newData.child('best').exists())",
            "completed": {
              ".validate": "newData.isBoolean() && (!data.exists() || data.val() === false || newData.val() === true)"
            },
            "rescues": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && (!data.exists() || newData.val() >= data.val())"
            },
            "best": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 3600 && (!data.exists() || newData.val() <= data.val())"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "seen": {
          "$screen": {
            ".write": "newData.exists()",
            ".validate": "$screen.matches(/^[A-Za-z0-9_-]{1,24}$/) && newData.val() === true"
          }
        },
        "praise": {
          "$kind": {
            ".write": "newData.exists()",
            ".validate": "$kind.matches(/^[A-Za-z]{1,24}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && (!data.exists() || newData.val() >= data.val())"
          }
        },
        "settings": {
          ".write": "newData.exists()",
          "sound": {
            ".validate": "newData.isBoolean()"
          },
          "control": {
            ".validate": "newData.isString() && newData.val().length <= 8"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
